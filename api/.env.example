DATABASE_URL=postgresql://app_user:replace-me@localhost:5432/recordatorios_dev
MIGRATION_DATABASE_URL=postgresql://migration_user:replace-me@localhost:5432/recordatorios_dev
# Sólo para provision_app_role.py; no configurar en Render.
APP_DB_PASSWORD=replace-with-at-least-32-random-characters
JWT_PRIVATE_KEY=replace-with-private-PEM-using-literal-\n-line-breaks
JWT_PUBLIC_KEY=replace-with-public-PEM-using-literal-\n-line-breaks
JWT_KID=local-key-1
JWT_ISSUER=recordatorios-api-local
JWT_AUDIENCE=recordatorios-web-local
REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_SECONDS=900
WORKER_POLL_SECONDS=10
# API y worker: activar sólo después de configurar la clave compartida.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_KEY=base64-of-32-random-bytes
# Sólo worker: secreto de al menos 32 caracteres, nunca en web/.
WHATSAPP_API_URL=https://recordatorios-whatsapp-kxia.onrender.com
WHATSAPP_SERVICE_TOKEN=replace-with-at-least-32-random-characters
