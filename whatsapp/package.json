{
  "name": "@recordatorios/whatsapp",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "pair": "tsx src/pair.ts",
    "db:check": "tsx src/check-db.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format:check": "git diff --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "24.8.0",
    "@types/pg": "8.15.5",
    "@types/qrcode-terminal": "0.12.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
